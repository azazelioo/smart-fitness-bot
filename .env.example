# Smart Fitness Bot - Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (for food recognition with Llama 3.2 Vision)
# Get FREE key from: https://console.groq.com/keys
# 7000 requests/day FREE - no credit card required!
GROQ_API_KEY=your_groq_api_key_here

# Database URL
# For local SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./fitness_bot.db
# For PostgreSQL (Supabase/Neon):
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname


